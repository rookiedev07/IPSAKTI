# ==============================================================================
# House of Cards — Root Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Keys (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 2. Node Dependencies & Build Outputs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.next/
out/
docs

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & Virtual Environments (Orchestration Engine)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Pytest & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. Logs, Runtime Data & Storage
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
*.sqlite
*.sqlite3
.tempmediaStorage/

# ------------------------------------------------------------------------------
# 5. OS & IDE Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini

# IDEs & Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ------------------------------------------------------------------------------
# 6. Temporary & Agent Files
# ------------------------------------------------------------------------------
.turbo/
.cache/
.parcel-cache/
tmp/
temp/
